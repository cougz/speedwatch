---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SpeedWatch">
  <style>
    :root {
      --c-upload: #58a6ff;
      --c-latency: #3fb950;
      --c-jitter: #bc8cff;
      --c-red: #f85149;
      --c-amber: #d29922;
      --c-green: #3fb950;
    }

    nav {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 32px; height: 56px;
      background: rgba(13,13,13,0.85); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--s3);
      position: sticky; top: 0; z-index: 100;
    }

    .nav-brand {
      display: flex; align-items: center; gap: 8px;
      font-size: 16px; font-weight: 600; color: var(--hi);
    }

    .nav-right { display: flex; align-items: center; gap: 10px; }

    .nav-pill {
      padding: 4px 12px; font-size: 11px; font-weight: 500;
      border-radius: 20px; background: var(--s2); color: var(--md);
      cursor: pointer; transition: all 0.15s ease;
      border: 1px solid var(--s3);
    }
    .nav-pill:hover { background: var(--s3); color: var(--hi); }
    .nav-pill.active { background: var(--brand-glow); border-color: var(--brand); color: var(--brand-light); }

    .live-pill { display: flex; align-items: center; gap: 6px; }
    .live-dot {
      width: 6px; height: 6px; background: var(--c-green);
      border-radius: 50%; animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.9); }
    }

    main { padding: 24px 32px; max-width: 1400px; margin: 0 auto; }

    .page-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 20px;
    }
    .page-title { font-size: 20px; font-weight: 600; color: var(--hi); }
    .page-meta { font-size: 12px; color: var(--lo); font-family: var(--mono); }

    .kpi-grid {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 14px; margin-bottom: 24px;
    }

    .kpi-card {
      background: var(--s1); border: 1px solid var(--s3);
      border-radius: 12px; padding: 18px 20px;
      position: relative; overflow: hidden;
      transition: border-color 0.2s ease, transform 0.2s ease;
      cursor: default;
    }
    .kpi-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: var(--card-accent);
    }
    .kpi-card:hover { border-color: var(--s4); transform: translateY(-1px); }

    .kpi-label {
      font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--lo); margin-bottom: 6px;
    }

    .kpi-value {
      font-size: 2rem; font-family: var(--mono); font-weight: 600;
      color: var(--hi); line-height: 1; margin-bottom: 4px;
    }
    .kpi-value.loading {
      background: linear-gradient(90deg, var(--s2) 25%, var(--s3) 50%, var(--s2) 75%);
      background-size: 200% 100%; animation: shimmer 1.5s infinite;
      color: transparent; border-radius: 4px;
    }
    @keyframes shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    .kpi-delta {
      font-size: 11px; color: var(--lo); font-family: var(--mono);
    }

    .kpi-sparkline { height: 36px; margin-top: 8px; }

    .incident-list {
      display: flex; flex-direction: column; gap: 8px; margin-top: 14px;
    }
    .no-incidents {
      display: flex; align-items: center; gap: 10px;
      background: var(--s1); border: 1px solid var(--s3);
      border-radius: 10px; padding: 14px 16px; font-size: 13px;
      color: #3fb950; font-weight: 500;
    }

    .chart-grid {
      display: grid; grid-template-columns: 1fr; gap: 14px;
      margin-bottom: 24px;
    }

    .chart-card {
      background: var(--s1); border: 1px solid var(--s3);
      border-radius: 12px; padding: 16px 20px;
    }

    .chart-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 12px;
    }
    .chart-title { font-size: 13px; font-weight: 600; color: var(--md); }
    .chart-legend { display: flex; gap: 12px; font-size: 11px; color: var(--lo); }
    .legend-item { display: flex; align-items: center; gap: 4px; }
    .legend-color { width: 8px; height: 8px; border-radius: 2px; }

    .table-card {
      background: var(--s1); border: 1px solid var(--s3);
      border-radius: 12px; padding: 16px 20px;
    }

    .table-container { overflow-x: auto; }
    table {
      width: 100%; border-collapse: collapse;
      font-size: 12px; font-family: var(--mono);
    }
    th {
      text-align: left; padding: 8px 12px; font-weight: 500;
      color: var(--lo); border-bottom: 1px solid var(--s3);
      position: sticky; top: 0; background: var(--s1);
    }
    td {
      padding: 8px 12px; border-bottom: 1px solid var(--s3);
      color: var(--md);
    }
    tr:hover td { background: var(--s2); }
    tr.hidden { display: none; }

    .status-badge {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 500;
    }
    .status-ok { color: var(--c-green); background: rgba(63,185,80,0.1); }
    .status-warn { color: var(--c-amber); background: rgba(210,153,34,0.1); }
    .status-fail { color: var(--c-red); background: rgba(248,81,73,0.1); }

    .load-more-btn {
      display: block; width: 100%; padding: 12px;
      background: var(--s2); border: 1px solid var(--s3);
      border-radius: 8px; color: var(--md); font-size: 12px;
      font-weight: 500; cursor: pointer; transition: all 0.15s ease;
      margin-top: 12px;
    }
    .load-more-btn:hover { background: var(--s3); color: var(--hi); }
    .load-more-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  </style>

  <nav>
    <div class="nav-brand">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="12" cy="12" r="10" fill="#F48024"/>
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59 8-8 8-3.59 8 8-3.59 8-8-8 8 8-3.59 0-1-13 0-1-1 1 0zm-1-13h2v2h2zm0 8h2v2h2zm0 0h2v2h2z" fill="white"/>
      </svg>
      SpeedWatch
    </div>
    <div class="nav-right">
      <div class="nav-pill time-pill" data-hours="1">1h</div>
      <div class="nav-pill time-pill" data-hours="6">6h</div>
      <div class="nav-pill time-pill active" data-hours="24">24h</div>
      <div class="nav-pill time-pill" data-hours="168">7d</div>
      <div class="nav-pill time-pill" data-hours="8760">All</div>
      <div class="nav-pill" id="custom-pill">Custom</div>
      <input type="date" id="custom-from" style="padding:4px 8px;font-size:11px;background:var(--s2);color:var(--lo);border:1px solid var(--s3);border-radius:4px;opacity:0.35;pointer-events:none;transition:opacity 0.2s,color 0.2s;">
      <input type="date" id="custom-to" style="padding:4px 8px;font-size:11px;background:var(--s2);color:var(--lo);border:1px solid var(--s3);border-radius:4px;opacity:0.35;pointer-events:none;transition:opacity 0.2s,color 0.2s;">
    </div>
  </nav>

  <main>
    <div class="page-header">
      <div class="page-title">Speedtest Dashboard</div>
      <div class="page-meta" id="page-meta">Loading...</div>
    </div>

    <div class="kpi-grid">
      <div class="kpi-card" style="--card-accent: var(--brand)">
        <div class="kpi-label">Avg Download</div>
        <div class="kpi-value loading" id="kpi-download">--</div>
        <div class="kpi-delta" id="kpi-download-delta">p95: --</div>
        <svg class="kpi-sparkline" viewBox="0 0 200 36" preserveAspectRatio="none">
          <defs>
            <linearGradient id="grad-download" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:var(--brand);stop-opacity:0.3"/>
              <stop offset="100%" style="stop-color:var(--brand);stop-opacity:0"/>
            </linearGradient>
          </defs>
          <path id="sparkline-download" fill="url(#grad-download)" stroke="var(--brand)" stroke-width="1.5"/>
        </svg>
      </div>

      <div class="kpi-card" style="--card-accent: var(--c-upload)">
        <div class="kpi-label">Avg Upload</div>
        <div class="kpi-value loading" id="kpi-upload">--</div>
        <div class="kpi-delta" id="kpi-upload-delta">p95: --</div>
        <svg class="kpi-sparkline" viewBox="0 0 200 36" preserveAspectRatio="none">
          <defs>
            <linearGradient id="grad-upload" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:var(--c-upload);stop-opacity:0.3"/>
              <stop offset="100%" style="stop-color:var(--c-upload);stop-opacity:0"/>
            </linearGradient>
          </defs>
          <path id="sparkline-upload" fill="url(#grad-upload)" stroke="var(--c-upload)" stroke-width="1.5"/>
        </svg>
      </div>

      <div class="kpi-card" style="--card-accent: var(--c-latency)">
        <div class="kpi-label">Avg Latency</div>
        <div class="kpi-value loading" id="kpi-latency">--</div>
        <div class="kpi-delta" id="kpi-latency-delta">p95: --</div>
        <svg class="kpi-sparkline" viewBox="0 0 200 36" preserveAspectRatio="none">
          <defs>
            <linearGradient id="grad-latency" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:var(--c-latency);stop-opacity:0.3"/>
              <stop offset="100%" style="stop-color:var(--c-latency);stop-opacity:0"/>
            </linearGradient>
          </defs>
          <path id="sparkline-latency" fill="url(#grad-latency)" stroke="var(--c-latency)" stroke-width="1.5"/>
        </svg>
      </div>

      <div class="kpi-card" style="--card-accent: var(--c-jitter)">
        <div class="kpi-label">Avg Jitter</div>
        <div class="kpi-value loading" id="kpi-jitter">--</div>
        <div class="kpi-delta" id="kpi-jitter-delta">p95: --</div>
        <svg class="kpi-sparkline" viewBox="0 0 200 36" preserveAspectRatio="none">
          <defs>
            <linearGradient id="grad-jitter" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:var(--c-jitter);stop-opacity:0.3"/>
              <stop offset="100%" style="stop-color:var(--c-jitter);stop-opacity:0"/>
            </linearGradient>
          </defs>
          <path id="sparkline-jitter" fill="url(#grad-jitter)" stroke="var(--c-jitter)" stroke-width="1.5"/>
        </svg>
      </div>
    </div>

    <div class="chart-card" style="margin-bottom:24px">
      <div class="chart-header" style="cursor:pointer; user-select:none" id="incidents-header">
        <div class="chart-title">
          Performance Incidents
          <span id="incident-badge" style="
            margin-left:8px; font-size:10px; font-weight:600;
            padding:2px 7px; border-radius:10px;
            background:rgba(248,81,73,0.15); color:#f85149;
            font-family:var(--mono); vertical-align:middle;
          ">0</span>
        </div>
        <div style="display:flex; align-items:center; gap:10px">
          <div id="incidents-toggle-label" style="font-size:11px; color:var(--lo); font-family:var(--mono)">Show</div>
          <div id="incidents-chevron" style="color:var(--lo); font-size:14px; transition:transform 0.2s">▼</div>
        </div>
      </div>
      <div id="incident-list" style="display:none; margin-top:12px"></div>
    </div>

    <div class="chart-grid">
      <div class="chart-card">
        <div class="chart-header">
          <div class="chart-title">Throughput Timeline</div>
          <div class="chart-legend">
            <div class="legend-item"><div class="legend-color" style="background:var(--brand)"></div> Download</div>
            <div class="legend-item"><div class="legend-color" style="background:var(--c-upload)"></div> Upload</div>
          </div>
        </div>
        <div style="position:relative; height:200px; width:100%">
          <canvas id="throughput-chart"></canvas>
        </div>
        <div class="chart-header" style="margin-top:16px; margin-bottom:8px;">
          <div class="chart-title">Latency Timeline</div>
          <div class="chart-legend">
            <div class="legend-item"><div class="legend-color" style="background:var(--c-latency)"></div> Latency</div>
          </div>
        </div>
        <div style="position:relative; height:100px; width:100%">
          <canvas id="latency-chart"></canvas>
        </div>
      </div>
    </div>

    <div class="chart-card" style="margin-bottom:24px">
      <div class="chart-title" style="margin-bottom:12px">Endpoint Breakdown</div>
      <div id="endpoint-cards"></div>
    </div>

    <div class="table-card">
      <div class="chart-header">
        <div class="chart-title">Recent Results</div>
      </div>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Endpoint</th>
              <th>Session</th>
              <th>Download Mbps</th>
              <th>Upload Mbps</th>
              <th>Latency ms</th>
              <th>DL Latency</th>
              <th>UL Latency</th>
              <th>Jitter ms</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody id="results-body"></tbody>
        </table>
      </div>
      <button class="load-more-btn" id="load-more" disabled>Load More</button>
    </div>
  </main>

  <script>
    declare var Chart: any;

    interface TimelinePoint { hour: string; downloadMbps: number; uploadMbps: number; latencyMs: number; jitterMs: number; count: number; }
    interface SpeedtestRecord { timestamp: string; sessionID: string; endpoint: string; endpointName: string; success: boolean; download: number; upload: number; latency: number; jitter: number; downLoadedLatency: number; downLoadedJitter: number; upLoadedLatency: number; upLoadedJitter: number; }
    interface Incident { start: string; end: string; level: string; affectedMetrics: string[]; recordCount: number; worstDownloadMbps: number; worstUploadMbps: number; worstLatencyMs: number; worstJitterMs: number; }
    interface EndpointSummary { name: string; count: number; avg: { downloadMbps: number; uploadMbps: number; latencyMs: number; jitterMs: number } }

    const THRESHOLDS = {
      download: { warn: 50, crit: 25 },
      upload: { warn: 20, crit: 10 },
      latency: { warn: 20, crit: 50 },
      jitter: { warn: 5, crit: 15 },
    };

    let selectedLimit = 100;
    let selectedEndpoint = 'all';
    let serverCursor: string | null = null;
    let displayedCount = 10;
    let selectedHours = 24;
    let allRecords: SpeedtestRecord[] = [];

    let throughputChart = null;
    let latencyChart = null;

    function classifyRecord(r: SpeedtestRecord): 'ok' | 'warn' | 'crit' {
      if (r.download < THRESHOLDS.download.crit || r.upload < THRESHOLDS.upload.crit || r.latency > THRESHOLDS.latency.crit || r.jitter > THRESHOLDS.jitter.crit) return 'crit';
      if (r.download < THRESHOLDS.download.warn || r.upload < THRESHOLDS.upload.warn || r.latency > THRESHOLDS.latency.warn || r.jitter > THRESHOLDS.jitter.warn) return 'warn';
      return 'ok';
    }

    function timelineToPath(points: TimelinePoint[], metric: keyof TimelinePoint, w: number, h: number): string {
      const values = points.map(p => Number(p[metric]));
      const max = Math.max(...values, 1);
      return points.map((p, i) => {
        const x = (i / (points.length - 1)) * w;
        const y = h - (Number(p[metric]) / max) * h;
        return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
      }).join(' ');
    }

    async function fetchData() {
      const meta = document.getElementById('page-meta');
      if (meta) meta.textContent = 'Loading...';
      try {
        const [summaryRes, resultsRes] = await Promise.all([
          fetch(`/api/summary?hours=${selectedHours}&no-cache=true`),
          fetch(`/api/results?limit=200`)
        ]);

        if (!summaryRes.ok) throw new Error(`Summary: ${summaryRes.status}`);
        if (!resultsRes.ok) throw new Error(`Results: ${resultsRes.status}`);

        const summary = await summaryRes.json();
        const results = await resultsRes.json();

        allRecords = results.records || [];
        serverCursor = results.cursor || null;
        displayedCount = 10;

        renderKpiCards(summary);
        renderCharts(summary);
        renderIncidents(summary.incidents || []);
        renderEndpoints(summary.byEndpoint || {});
        renderTable();
        updatePageMeta(summary);
      } catch (err) {
        console.error('fetchData error:', err);
        if (meta) meta.textContent = `Error: ${err instanceof Error ? err.message : 'Unknown error'}`;
      }
    }

    function renderKpiCards(summary: any) {
      const updateKpi = (id: string, value: number, delta: number, p95Value: number) => {
        const el = document.getElementById(id);
        const deltaEl = document.getElementById(`${id}-delta`);
        el.classList.remove('loading');
        el.textContent = value.toFixed(1);
        deltaEl.textContent = `p95: ${p95Value.toFixed(1)}`;
      };

      updateKpi('kpi-download', summary.avg.downloadMbps, 0, summary.p95.downloadMbps);
      updateKpi('kpi-upload', summary.avg.uploadMbps, 0, summary.p95.uploadMbps);
      updateKpi('kpi-latency', summary.avg.latencyMs, 0, summary.p95.latencyMs);
      updateKpi('kpi-jitter', summary.avg.jitterMs, 0, summary.p95.jitterMs);

      const sparkPath = timelineToPath(summary.timeline, 'downloadMbps', 200, 36);
      document.getElementById('sparkline-download').setAttribute('d', sparkPath + ' L200,36 L0,36 Z');

      const sparkUploadPath = timelineToPath(summary.timeline, 'uploadMbps', 200, 36);
      document.getElementById('sparkline-upload').setAttribute('d', sparkUploadPath + ' L200,36 L0,36 Z');

      const sparkLatPath = timelineToPath(summary.timeline, 'latencyMs', 200, 36);
      document.getElementById('sparkline-latency').setAttribute('d', sparkLatPath + ' L200,36 L0,36 Z');

      const sparkJitPath = timelineToPath(summary.timeline, 'jitterMs', 200, 36);
      document.getElementById('sparkline-jitter').setAttribute('d', sparkJitPath + ' L200,36 L0,36 Z');
    }

    function renderCharts(summary) {
      const tl = summary.timeline || [];
      if (tl.length === 0) return;
      if (typeof Chart === 'undefined') return;

      const throughputCanvas = document.getElementById('throughput-chart') as HTMLCanvasElement;
      const latencyCanvas = document.getElementById('latency-chart') as HTMLCanvasElement;

      if (!throughputCanvas || !latencyCanvas) return;

      const labels = tl.map(p => {
        const d = new Date(p.hour);
        return d.toLocaleDateString([], {month:'short', day:'numeric'}) + ' ' +
               d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
      });

      const chartDefaults = {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#222',
            titleColor: '#d0d0d0',
            bodyColor: '#888',
            borderColor: '#2e2e2e',
            borderWidth: 1,
          }
        },
        scales: {
          x: {
            ticks: { color: '#888', font: { family: 'monospace', size: 10 }, maxTicksLimit: 8 },
            grid: { color: '#2e2e2e' }
          },
          y: {
            ticks: { color: '#888', font: { family: 'monospace', size: 10 } },
            grid: { color: '#2e2e2e' },
            beginAtZero: true
          }
        }
      };

      if (throughputChart) { throughputChart.destroy(); throughputChart = null; }
      if (latencyChart) { latencyChart.destroy(); latencyChart = null; }

      throughputChart = new Chart(throughputCanvas.getContext('2d'), {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'Download Mbps',
              data: tl.map(p => p.downloadMbps),
              borderColor: '#F48024',
              backgroundColor: 'rgba(244,128,36,0.1)',
              fill: true,
              tension: 0.3,
              pointRadius: 0,
              borderWidth: 2,
            },
            {
              label: 'Upload Mbps',
              data: tl.map(p => p.uploadMbps),
              borderColor: '#58a6ff',
              backgroundColor: 'rgba(88,166,255,0.1)',
              fill: true,
              tension: 0.3,
              pointRadius: 0,
              borderWidth: 2,
            }
          ]
        },
        options: {
          ...chartDefaults,
          plugins: {
            ...chartDefaults.plugins,
            legend: {
              display: true,
              labels: { color: '#888', font: { family: 'monospace', size: 11 }, boxWidth: 12 }
            }
          }
        }
      });

      latencyChart = new Chart(latencyCanvas.getContext('2d'), {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'Latency ms',
            data: tl.map(p => p.latencyMs),
            borderColor: '#3fb950',
            backgroundColor: 'rgba(63,185,80,0.1)',
            fill: true,
            tension: 0.3,
            pointRadius: 0,
            borderWidth: 2,
          }]
        },
        options: chartDefaults
      });
    }

    let incidentsExpanded = false;

    function renderIncidents(incidents: Incident[]) {
      const list = document.getElementById('incident-list');
      const badge = document.getElementById('incident-badge');
      const chevron = document.getElementById('incidents-chevron');
      const toggleLabel = document.getElementById('incidents-toggle-label');
      if (!list) return;

      if (badge) {
        badge.textContent = String(incidents?.length || 0);
        badge.style.background = incidents?.length ? 'rgba(248,81,73,0.15)' : 'rgba(63,185,80,0.15)';
        badge.style.color = incidents?.length ? '#f85149' : '#3fb950';
      }

      list.innerHTML = '';

      if (!incidents || !incidents.length) {
        list.innerHTML = '<div class="no-incidents">✓ No performance incidents detected</div>';
      } else {
        for (const inc of incidents) {
          const start = new Date(inc.start);
          const end = new Date(inc.end);
          const durationMs = end.getTime() - start.getTime();
          const durationStr = durationMs < 60_000
            ? `${Math.round(durationMs / 1000)}s`
            : `${Math.round(durationMs / 60_000)}m`;
          const isMulti = inc.start !== inc.end;
          const timeStr = isMulti
            ? `${start.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})} – ${end.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})}, ${start.toLocaleDateString([], {month:'short', day:'numeric', year:'numeric'})}`
            : start.toLocaleString([], {month:'short', day:'numeric', year:'numeric', hour:'2-digit', minute:'2-digit'});

          const metrics = [
            { label: 'Download', value: `${inc.worstDownloadMbps.toFixed(1)} Mbps`, affected: inc.affectedMetrics.includes('download') },
            { label: 'Upload',   value: `${inc.worstUploadMbps.toFixed(1)} Mbps`,   affected: inc.affectedMetrics.includes('upload') },
            { label: 'Latency', value: `${inc.worstLatencyMs.toFixed(1)} ms`,      affected: inc.affectedMetrics.includes('latency') },
            { label: 'Jitter',   value: `${inc.worstJitterMs.toFixed(2)} ms`,       affected: inc.affectedMetrics.includes('jitter') },
          ];

          const levelLabel = inc.level === 'crit' ? 'Critical degradation' : 'Performance warning';
          const levelColor = inc.level === 'crit' ? '#f85149' : '#d29922';
          const affectedStr = inc.affectedMetrics
            .map(m => m.charAt(0).toUpperCase() + m.slice(1))
            .join(', ');

          const card = document.createElement('div');
          card.className = `incident-card level-${inc.level}`;
          card.style.cssText = `
            background: var(--s2);
            border: 1px solid var(--s3);
            border-left: 3px solid ${inc.level === 'crit' ? '#f85149' : '#d29922'};
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 10px;
          `;
          card.innerHTML = `
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px">
              <div>
                <span style="font-size:13px; font-weight:600; color:${levelColor}">${levelLabel}</span>
                <span style="font-size:12px; color:var(--lo); margin-left:8px">— ${affectedStr}</span>
              </div>
              <span style="font-size:11px; color:var(--lo); font-family:var(--mono); white-space:nowrap; margin-left:16px">
                ${inc.recordCount} test${inc.recordCount !== 1 ? 's' : ''}${isMulti ? ` · ${durationStr}` : ''}
              </span>
            </div>
            <div style="font-size:11px; color:var(--lo); font-family:var(--mono); margin-bottom:12px">${timeStr}</div>
            <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:8px">
              ${metrics.map(m => `
                <div style="
                  background: var(--s1);
                  border: 1px solid ${m.affected ? (inc.level === 'crit' ? 'rgba(248,81,73,0.3)' : 'rgba(210,153,34,0.3)') : 'var(--s3)'};
                  border-radius: 8px;
                  padding: 8px 10px;
                ">
                  <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.08em; color:var(--lo); margin-bottom:4px">${m.label}</div>
                  <div style="font-size:13px; font-weight:600; font-family:var(--mono); color:${m.affected ? (inc.level === 'crit' ? '#f85149' : '#d29922') : 'var(--md)'}">${m.value}</div>
                </div>
              `).join('')}
            </div>
          `;
          list.appendChild(card);
        }
      }

      if (chevron) chevron.style.transform = incidentsExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
      if (toggleLabel) toggleLabel.textContent = incidentsExpanded ? 'Hide' : 'Show';
      list.style.display = incidentsExpanded ? 'block' : 'none';
    }

    function renderEndpoints(byEndpoint: Record<string, EndpointSummary>) {
      const container = document.getElementById('endpoint-tbody');
      if (!container) return;

      const wrapper = document.getElementById('endpoint-cards');
      if (!wrapper) return;
      wrapper.innerHTML = '';

      const entries = Object.values(byEndpoint || {}) as EndpointSummary[];
      if (entries.length === 0) {
        wrapper.innerHTML = '<div style="text-align:center;color:var(--lo);padding:24px;font-size:13px">No endpoint data</div>';
        return;
      }

      entries.sort((a, b) => b.count - a.count);
      const maxDl = Math.max(...entries.map(e => e.avg.downloadMbps), 1);

      for (const ep of entries) {
        const barPct = Math.round((ep.avg.downloadMbps / maxDl) * 100);
        const card = document.createElement('div');
        card.style.cssText = `
          background: var(--s2);
          border: 1px solid var(--s3);
          border-radius: 10px;
          padding: 14px 16px;
          margin-bottom: 10px;
        `;
        card.innerHTML = `
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px">
            <div style="font-size:13px; font-weight:600; color:var(--hi); font-family:var(--mono)">${ep.name}</div>
            <div style="font-size:11px; color:var(--lo); font-family:var(--mono)">${ep.count} test${ep.count !== 1 ? 's' : ''}</div>
          </div>
          <div style="height:3px; background:var(--s3); border-radius:2px; margin-bottom:12px; overflow:hidden">
            <div style="height:100%; width:${barPct}%; background:var(--brand); border-radius:2px; transition:width 0.4s ease"></div>
          </div>
          <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:8px">
            <div style="background:var(--s1); border:1px solid var(--s3); border-radius:8px; padding:8px 10px">
              <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.08em; color:var(--lo); margin-bottom:4px">Download</div>
              <div style="font-size:13px; font-weight:600; font-family:var(--mono); color:var(--brand)">${ep.avg.downloadMbps.toFixed(1)} <span style="font-size:10px;font-weight:400;color:var(--lo)">Mbps</span></div>
            </div>
            <div style="background:var(--s1); border:1px solid var(--s3); border-radius:8px; padding:8px 10px">
              <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.08em; color:var(--lo); margin-bottom:4px">Upload</div>
              <div style="font-size:13px; font-weight:600; font-family:var(--mono); color:#58a6ff">${ep.avg.uploadMbps.toFixed(1)} <span style="font-size:10px;font-weight:400;color:var(--lo)">Mbps</span></div>
            </div>
            <div style="background:var(--s1); border:1px solid var(--s3); border-radius:8px; padding:8px 10px">
              <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.08em; color:var(--lo); margin-bottom:4px">Latency</div>
              <div style="font-size:13px; font-weight:600; font-family:var(--mono); color:#3fb950">${ep.avg.latencyMs.toFixed(1)} <span style="font-size:10px;font-weight:400;color:var(--lo)">ms</span></div>
            </div>
            <div style="background:var(--s1); border:1px solid var(--s3); border-radius:8px; padding:8px 10px">
              <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.08em; color:var(--lo); margin-bottom:4px">Jitter</div>
              <div style="font-size:13px; font-weight:600; font-family:var(--mono); color:#bc8cff">${ep.avg.jitterMs.toFixed(2)} <span style="font-size:10px;font-weight:400;color:var(--lo)">ms</span></div>
            </div>
          </div>
        `;
        wrapper.appendChild(card);
      }
    }

    function renderTable() {
      const tbody = document.getElementById('results-body');
      tbody.innerHTML = '';

      const filtered = selectedEndpoint === 'all'
        ? allRecords
        : allRecords.filter(r => r.endpointName === selectedEndpoint);

      const slice = filtered.slice(0, displayedCount);
      for (const rec of slice) {
        const level = classifyRecord(rec);
        const statusColor = !rec.success ? '#f85149' : level === 'crit' ? '#f85149' : level === 'warn' ? '#d29922' : '#3fb950';
        const statusBg    = !rec.success ? 'rgba(248,81,73,0.1)' : level === 'crit' ? 'rgba(248,81,73,0.1)' : level === 'warn' ? 'rgba(210,153,34,0.1)' : 'rgba(63,185,80,0.1)';
        const statusText  = !rec.success ? '✗ Fail' : level === 'crit' ? '⚠ Slow' : level === 'warn' ? '⚠ Slow' : '✓ OK';

        const row = document.createElement('tr');
        row.style.cssText = 'border-bottom: 1px solid var(--s3); transition: background 0.15s';
        row.onmouseenter = () => row.style.background = 'var(--s2)';
        row.onmouseleave = () => row.style.background = '';
        row.innerHTML = `
          <td style="padding:10px 12px; color:var(--lo); font-family:var(--mono); font-size:11px; white-space:nowrap">
            ${new Date(rec.timestamp).toLocaleString([], {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit'})}
          </td>
          <td style="padding:10px 12px; font-family:var(--mono); font-size:11px; color:var(--hi)">${rec.endpointName}</td>
          <td style="padding:10px 12px; font-family:var(--mono); font-size:11px; color:var(--lo)">${rec.sessionID.substring(0,8)}…</td>
          <td style="padding:10px 12px">
            <span style="font-family:var(--mono); font-size:12px; font-weight:600; color:var(--brand)">${rec.download.toFixed(1)}</span>
            <span style="font-family:var(--mono); font-size:10px; color:var(--lo)"> Mbps</span>
          </td>
          <td style="padding:10px 12px">
            <span style="font-family:var(--mono); font-size:12px; font-weight:600; color:#58a6ff">${rec.upload.toFixed(1)}</span>
            <span style="font-family:var(--mono); font-size:10px; color:var(--lo)"> Mbps</span>
          </td>
          <td style="padding:10px 12px">
            <span style="font-family:var(--mono); font-size:12px; font-weight:600; color:#3fb950">${rec.latency.toFixed(1)}</span>
            <span style="font-family:var(--mono); font-size:10px; color:var(--lo)"> ms</span>
          </td>
          <td style="padding:10px 12px; font-family:var(--mono); font-size:11px; color:var(--lo)">${rec.downLoadedLatency.toFixed(1)} ms</td>
          <td style="padding:10px 12px; font-family:var(--mono); font-size:11px; color:var(--lo)">${rec.upLoadedLatency.toFixed(1)} ms</td>
          <td style="padding:10px 12px">
            <span style="font-family:var(--mono); font-size:12px; font-weight:600; color:#bc8cff">${rec.jitter.toFixed(2)}</span>
            <span style="font-family:var(--mono); font-size:10px; color:var(--lo)"> ms</span>
          </td>
          <td style="padding:10px 12px">
            <span style="display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:6px; font-size:11px; font-weight:600; background:${statusBg}; color:${statusColor}; font-family:var(--mono)">${statusText}</span>
          </td>
        `;
        tbody.appendChild(row);
      }
      updateLoadMoreBtn(filtered);
    }

    function updateLoadMoreBtn(filtered) {
      const btn = document.getElementById('load-more') as HTMLButtonElement;
      const hasMoreLocal  = filtered.length > displayedCount;
      const hasMoreServer = !!serverCursor;
      btn.disabled = !hasMoreLocal && !hasMoreServer;
      if (hasMoreLocal) {
        btn.textContent = `Show More (${filtered.length - displayedCount} in memory)`;
      } else if (hasMoreServer) {
        btn.textContent = 'Load More from Server';
      } else {
        btn.textContent = 'No More Results';
      }
    }

    function updatePageMeta(summary) {
      const meta = document.getElementById('page-meta');
      const pct = summary.successRate >= 1 ? '100%' : `${(summary.successRate * 100).toFixed(0)}%`;
      meta.textContent = `${summary.totalRecords} records · ${pct} success · last ${selectedHours}h`;
    }

    document.querySelectorAll('.count-pill').forEach(pill => {
      const pillEl = pill as HTMLElement;
      pillEl.addEventListener('click', () => {
        document.querySelectorAll('.count-pill').forEach(p => p.classList.remove('active'));
        pillEl.classList.add('active');
        selectedLimit = parseInt(pillEl.dataset.limit || '100');
        fetchData();
      });
    });

    document.querySelectorAll('.time-pill').forEach(pill => {
      const pillEl = pill as HTMLElement;
      pillEl.addEventListener('click', () => {
        document.querySelectorAll('.time-pill').forEach(p => p.classList.remove('active'));
        document.getElementById('custom-pill')?.classList.remove('active');
        pillEl.classList.add('active');
        selectedHours = parseInt(pillEl.dataset.hours || '24', 10);
        const fromInput = document.getElementById('custom-from') as HTMLInputElement;
        const toInput = document.getElementById('custom-to') as HTMLInputElement;
        fromInput.style.opacity = '0.35';
        fromInput.style.color = 'var(--lo)';
        fromInput.style.pointerEvents = 'none';
        fromInput.value = '';
        toInput.style.opacity = '0.35';
        toInput.style.color = 'var(--lo)';
        toInput.style.pointerEvents = 'none';
        toInput.value = '';
        fetchData();
      });
    });

    document.getElementById('custom-pill')?.addEventListener('click', () => {
      document.querySelectorAll('.time-pill').forEach(p => p.classList.remove('active'));
      document.getElementById('custom-pill')?.classList.add('active');
      const fromInput = document.getElementById('custom-from') as HTMLInputElement;
      const toInput = document.getElementById('custom-to') as HTMLInputElement;
      fromInput.style.opacity = '1';
      fromInput.style.color = 'var(--hi)';
      fromInput.style.pointerEvents = 'auto';
      toInput.style.opacity = '1';
      toInput.style.color = 'var(--hi)';
      toInput.style.pointerEvents = 'auto';
      fromInput.focus();
    });

    function applyCustomDateRange() {
      const fromInput = document.getElementById('custom-from') as HTMLInputElement;
      const toInput = document.getElementById('custom-to') as HTMLInputElement;
      if (fromInput.value && toInput.value) {
        const fromDate = new Date(fromInput.value);
        const toDate = new Date(toInput.value);
        const diffMs = toDate.getTime() - fromDate.getTime();
        const hours = diffMs / (1000 * 60 * 60);
        if (hours > 0) {
          selectedHours = hours;
          fetchData();
        }
      }
    }

    document.getElementById('custom-from')?.addEventListener('change', applyCustomDateRange);
    document.getElementById('custom-to')?.addEventListener('change', applyCustomDateRange);

    document.getElementById('incidents-header')?.addEventListener('click', () => {
      incidentsExpanded = !incidentsExpanded;
      const list = document.getElementById('incident-list');
      const chevron = document.getElementById('incidents-chevron');
      const toggleLabel = document.getElementById('incidents-toggle-label');
      if (list) list.style.display = incidentsExpanded ? 'block' : 'none';
      if (chevron) chevron.style.transform = incidentsExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
      if (toggleLabel) toggleLabel.textContent = incidentsExpanded ? 'Hide' : 'Show';
    });

    document.getElementById('load-more')?.addEventListener('click', async () => {
      const filtered = selectedEndpoint === 'all'
        ? allRecords
        : allRecords.filter(r => r.endpointName === selectedEndpoint);

      if (filtered.length > displayedCount) {
        displayedCount += 10;
        renderTable();
        return;
      }

      if (!serverCursor) return;
      const btn = document.getElementById('load-more') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Loading…';
      try {
        const res  = await fetch(`/api/results?limit=100&cursor=${serverCursor}`);
        const data = await res.json();
        allRecords   = allRecords.concat(data.records || []);
        serverCursor = data.cursor || null;
        renderTable();
      } catch (err) {
        console.error('Failed to load more:', err);
        btn.disabled = false;
        btn.textContent = 'Retry Load More';
      }
    });

    function init() {
      if (typeof Chart === 'undefined') {
        setTimeout(init, 100);
        return;
      }
      setInterval(fetchData, 60000);
      fetchData();
    }

    init();
  </script>
</Layout>
