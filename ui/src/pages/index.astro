---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SpeedWatch">
  <style>
    :root {
      --c-upload: #58a6ff;
      --c-latency: #3fb950;
      --c-jitter: #bc8cff;
      --c-red: #f85149;
      --c-amber: #d29922;
      --c-green: #3fb950;
    }

    main { padding: 0 32px; max-width: 1400px; margin: 0 auto; }

    .options-row {
      display: flex; align-items: center; justify-content: center;
      gap: 8px; flex-wrap: wrap; margin-bottom: 24px;
    }

    .pill {
      display: flex; align-items: center; gap: 4px;
      padding: 5px 12px; border-radius: 20px;
      border: 1px solid var(--border-color); background: var(--bg-tertiary);
      color: var(--text-secondary); font-size: 12px; font-weight: 500;
      cursor: pointer; transition: all 0.15s ease;
      user-select: none;
    }
    .pill:hover { border-color: var(--cf-orange); color: var(--cf-orange); }
    .pill.active { border-color: var(--cf-orange); background: rgba(244,128,36,0.1); color: var(--cf-orange-light); }

    .divider {
      width: 100%; max-width: 960px; margin: 0 auto 24px;
      height: 1px; background: var(--border-color); border: none;
    }

    .hero {
      text-align: center;
      padding: 80px 0 40px;
    }
    .hero-title {
      font-size: 2.8rem;
      font-weight: 700;
      line-height: 1.15;
      margin-bottom: 16px;
      background: linear-gradient(135deg, #ffffff 0%, var(--cf-orange-light) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-subtitle {
      font-size: 1rem;
      color: var(--text-secondary);
      line-height: 1.6;
      max-width: 480px;
      margin: 0 auto;
    }
    .meta-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-bottom: 16px;
      max-width: 960px;
      margin-left: auto;
      margin-right: auto;
    }
    .meta-row > * {
      font-size: 13px;
      color: var(--text-secondary);
    }
    .live-dot {
      width: 8px; height: 8px;
      background: var(--c-green);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.9); }
    }
    .powered-by {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 0.85em;
      color: var(--text-muted);
    }
    .cf-workers-icon {
      color: var(--cf-orange);
      vertical-align: text-bottom;
    }
    .powered-by a {
      color: var(--cf-orange);
      font-weight: 500;
    }

    .kpi-grid {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 14px; margin-bottom: 24px;
    }

    .kpi-card {
      background: var(--bg-secondary); border: 1px solid var(--border-color);
      border-radius: 12px; padding: 18px 20px;
      position: relative; overflow: hidden;
      transition: border-color 0.2s ease, transform 0.2s ease;
      cursor: default;
    }
    .kpi-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: var(--card-accent);
    }
    .kpi-card:hover { border-color: var(--border-color); transform: translateY(-1px); }

    .kpi-label {
      font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--text-muted); margin-bottom: 6px;
    }

    .kpi-value {
      font-size: 2rem; font-family: var(--mono); font-weight: 600;
      color: var(--hi); line-height: 1; margin-bottom: 4px;
    }
    .kpi-value.loading {
      background: linear-gradient(90deg, #1a1a1a 25%, #2e2e2e 50%, #1a1a1a 75%);
      background-size: 200% 100%; animation: shimmer 1.5s infinite;
      color: transparent; border-radius: 4px;
    }
    @keyframes shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    .kpi-delta {
      font-size: 11px; color: var(--text-muted); font-family: var(--mono);
    }

    .kpi-sparkline { height: 36px; margin-top: 8px; }

    .incident-list {
      display: flex; flex-direction: column; gap: 8px; margin-top: 14px;
    }
    .no-incidents {
      display: flex; align-items: center; gap: 10px;
      background: var(--bg-secondary); border: 1px solid var(--border-color);
      border-radius: 10px; padding: 14px 16px; font-size: 13px;
      color: #3fb950; font-weight: 500;
    }

    .chart-grid {
      display: grid; grid-template-columns: 1fr; gap: 14px;
      margin-bottom: 24px;
    }

    .chart-card {
      background: var(--bg-secondary); border: 1px solid var(--border-color);
      border-radius: 12px; padding: 16px 20px;
    }

    .chart-header {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 12px;
    }
    .chart-title { font-size: 13px; font-weight: 600; color: var(--md); }
    .chart-legend { display: flex; gap: 12px; font-size: 11px; color: var(--text-muted); }
    .legend-item { display: flex; align-items: center; gap: 4px; }
    .legend-color { width: 8px; height: 8px; border-radius: 2px; }

    .table-card {
      background: var(--bg-secondary); border: 1px solid var(--border-color);
      border-radius: 12px; padding: 16px 20px;
    }

    .table-container { overflow-x: auto; }
    table {
      width: 100%; border-collapse: collapse;
      font-size: 12px; font-family: var(--mono);
    }
    th {
      text-align: left; padding: 8px 12px; font-weight: 500;
      color: var(--text-muted); border-bottom: 1px solid var(--border-color);
      position: sticky; top: 0; background: var(--bg-secondary);
    }
    td {
      padding: 8px 12px; border-bottom: 1px solid var(--border-color);
      color: var(--md);
    }
    tr:hover td { background: var(--bg-tertiary); }
    tr.hidden { display: none; }

    .status-badge {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 500;
    }
    .status-ok { color: var(--c-green); background: rgba(63,185,80,0.1); }
    .status-warn { color: var(--c-amber); background: rgba(210,153,34,0.1); }
    .status-fail { color: var(--c-red); background: rgba(248,81,73,0.1); }

    .load-more-btn {
      display: block; width: 100%; padding: 12px;
      background: var(--bg-tertiary); border: 1px solid var(--border-color);
      border-radius: 8px; color: var(--md); font-size: 12px;
      font-weight: 500; cursor: pointer; transition: all 0.15s ease;
      margin-top: 12px;
    }
    .load-more-btn:hover { background: var(--border-color); color: var(--hi); }
    .load-more-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    @media (max-width: 600px) {
      .hero { padding: 56px 0 32px; }
      .hero-title { font-size: 2rem; }
    }

    footer {
      margin-top: auto;
      padding: 24px 0 32px;
      text-align: center;
      color: var(--text-secondary);
      font-size: 12px;
    }
    footer a { color: var(--text-secondary); }
    footer a:hover { color: var(--cf-orange); }
    footer code {
      background: var(--bg-tertiary);
      padding: 1px 5px;
      border-radius: 3px;
      font-size: 11px;
    }
    .footer-github {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      vertical-align: middle;
    }
    .footer-github svg {
      width: 14px;
      height: 14px;
      vertical-align: middle;
    }
  </style>

  <main>
    <div class="hero">
      <h1 class="hero-title">Welcome to SpeedWatch</h1>
      <p class="hero-subtitle">
        Monitor Cloudflare speedtests in real-time with performance insights and incident detection.
        <br>
        <span class="powered-by">
          Powered by
          <svg viewBox="0 0 50 50" width="18" height="18" fill="currentColor" aria-hidden="true" class="cf-workers-icon">
            <path d="m18.63 37.418-9.645-12.9 9.592-12.533-1.852-2.527L5.917 23.595l-.015 1.808 10.86 14.542z"></path>
            <path d="M21.997 6.503h-3.712l13.387 18.3-13.072 17.7h3.735L35.4 24.81z"></path>
            <path d="M29.175 6.503h-3.758l13.598 18.082-13.598 17.918h3.765l12.908-17.01v-1.808z"></path>
          </svg>
          <a href="https://workers.cloudflare.com/" target="_blank" rel="noopener">Cloudflare Workers</a>
        </span>
      </p>
    </div>

    <div class="meta-row">
      <span class="live-dot"></span>
      <span id="page-meta">Loading...</span>
    </div>

    <div class="options-row">
      <div class="pill time-pill" data-hours="1">1h</div>
      <div class="pill time-pill" data-hours="6">6h</div>
      <div class="pill time-pill active" data-hours="24">24h</div>
      <div class="pill time-pill" data-hours="168">7d</div>
      <div class="pill time-pill" data-hours="8760">All</div>
      <div class="pill" id="custom-pill">Custom</div>
      <input type="date" id="custom-from" style="padding:4px 8px;font-size:11px;background:var(--bg-tertiary);color:var(--text-muted);border:1px solid var(--border-color);border-radius:4px;opacity:0.35;pointer-events:none;transition:opacity 0.2s,color 0.2s;">
      <input type="date" id="custom-to" style="padding:4px 8px;font-size:11px;background:var(--bg-tertiary);color:var(--text-muted);border:1px solid var(--border-color);border-radius:4px;opacity:0.35;pointer-events:none;transition:opacity 0.2s,color 0.2s;">
    </div>

    <hr class="divider" />

    <div class="kpi-grid">
      <div class="kpi-card" style="--card-accent: var(--brand)">
        <div class="kpi-label">Avg Download</div>
        <div class="kpi-value loading" id="kpi-download">--</div>
        <div class="kpi-delta" id="kpi-download-delta">p95: --</div>
        <svg class="kpi-sparkline" viewBox="0 0 200 36" preserveAspectRatio="none">
          <defs>
            <linearGradient id="grad-download" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:var(--brand);stop-opacity:0.3"/>
              <stop offset="100%" style="stop-color:var(--brand);stop-opacity:0"/>
            </linearGradient>
          </defs>
          <path id="sparkline-download" fill="url(#grad-download)" stroke="var(--brand)" stroke-width="1.5"/>
        </svg>
      </div>

      <div class="kpi-card" style="--card-accent: var(--c-upload)">
        <div class="kpi-label">Avg Upload</div>
        <div class="kpi-value loading" id="kpi-upload">--</div>
        <div class="kpi-delta" id="kpi-upload-delta">p95: --</div>
        <svg class="kpi-sparkline" viewBox="0 0 200 36" preserveAspectRatio="none">
          <defs>
            <linearGradient id="grad-upload" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:var(--c-upload);stop-opacity:0.3"/>
              <stop offset="100%" style="stop-color:var(--c-upload);stop-opacity:0"/>
            </linearGradient>
          </defs>
          <path id="sparkline-upload" fill="url(#grad-upload)" stroke="var(--c-upload)" stroke-width="1.5"/>
        </svg>
      </div>

      <div class="kpi-card" style="--card-accent: var(--c-latency)">
        <div class="kpi-label">Avg Latency</div>
        <div class="kpi-value loading" id="kpi-latency">--</div>
        <div class="kpi-delta" id="kpi-latency-delta">p95: --</div>
        <svg class="kpi-sparkline" viewBox="0 0 200 36" preserveAspectRatio="none">
          <defs>
            <linearGradient id="grad-latency" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:var(--c-latency);stop-opacity:0.3"/>
              <stop offset="100%" style="stop-color:var(--c-latency);stop-opacity:0"/>
            </linearGradient>
          </defs>
          <path id="sparkline-latency" fill="url(#grad-latency)" stroke="var(--c-latency)" stroke-width="1.5"/>
        </svg>
      </div>

      <div class="kpi-card" style="--card-accent: var(--c-jitter)">
        <div class="kpi-label">Avg Jitter</div>
        <div class="kpi-value loading" id="kpi-jitter">--</div>
        <div class="kpi-delta" id="kpi-jitter-delta">p95: --</div>
        <svg class="kpi-sparkline" viewBox="0 0 200 36" preserveAspectRatio="none">
          <defs>
            <linearGradient id="grad-jitter" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" style="stop-color:var(--c-jitter);stop-opacity:0.3"/>
              <stop offset="100%" style="stop-color:var(--c-jitter);stop-opacity:0"/>
            </linearGradient>
          </defs>
          <path id="sparkline-jitter" fill="url(#grad-jitter)" stroke="var(--c-jitter)" stroke-width="1.5"/>
        </svg>
      </div>
    </div>

    <div class="chart-card" style="margin-bottom:24px">
      <div class="chart-header" style="cursor:pointer; user-select:none" id="incidents-header">
        <div class="chart-title">
          Performance Incidents
          <span id="incident-badge" style="
            margin-left:8px; font-size:10px; font-weight:600;
            padding:2px 7px; border-radius:10px;
            background:rgba(248,81,73,0.15); color:#f85149;
            font-family:var(--mono); vertical-align:middle;
          ">0</span>
        </div>
        <div style="display:flex; align-items:center; gap:10px">
          <div id="incidents-toggle-label" style="font-size:11px; color:var(--text-muted); font-family:var(--mono)">Show</div>
          <div id="incidents-chevron" style="color:var(--text-muted); font-size:14px; transition:transform 0.2s">▼</div>
        </div>
      </div>
      <div id="incident-list" style="display:none; margin-top:12px"></div>
    </div>

    <div class="chart-grid">
      <div class="chart-card">
        <div class="chart-header">
          <div class="chart-title">Throughput Timeline</div>
          <div class="chart-legend">
            <div class="legend-item"><div class="legend-color" style="background:var(--brand)"></div> Download</div>
            <div class="legend-item"><div class="legend-color" style="background:var(--c-upload)"></div> Upload</div>
          </div>
        </div>
        <div style="position:relative; height:200px; width:100%">
          <canvas id="throughput-chart"></canvas>
        </div>
        <div class="chart-header" style="margin-top:16px; margin-bottom:8px;">
          <div class="chart-title">Latency Timeline</div>
          <div class="chart-legend">
            <div class="legend-item"><div class="legend-color" style="background:var(--c-latency)"></div> Latency</div>
          </div>
        </div>
        <div style="position:relative; height:100px; width:100%">
          <canvas id="latency-chart"></canvas>
        </div>
      </div>
    </div>

    <div class="chart-card" style="margin-bottom:24px">
      <div class="chart-title" style="margin-bottom:12px">Endpoint Breakdown</div>
      <div id="endpoint-cards"></div>
    </div>

    <div class="table-card">
      <div class="chart-header">
        <div class="chart-title">Recent Results</div>
      </div>
      <div class="table-container">
        <table>
          <colgroup>
            <col style="width:16%">
            <col style="width:18%">
            <col style="width:11%">
            <col style="width:9%">
            <col style="width:9%">
            <col style="width:8%">
            <col style="width:10%">
            <col style="width:10%">
            <col style="width:9%">
          </colgroup>
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Endpoint</th>
              <th>Session</th>
              <th>Download</th>
              <th>Upload</th>
              <th>Latency</th>
              <th>DL Latency</th>
              <th>UL Latency</th>
              <th>Jitter</th>
            </tr>
          </thead>
          <tbody id="results-body"></tbody>
        </table>
      </div>
      <button class="load-more-btn" id="load-more" disabled>Load More</button>
    </div>

    <footer>
      <p>
        SpeedWatch &nbsp;·&nbsp;
        <a href="/llms.txt">llms.txt</a>
        &nbsp;·&nbsp;
        API: <code>/api/summary</code>
        &nbsp;·&nbsp;
        API: <code>/api/results</code>
        &nbsp;·&nbsp;
        <a href="https://github.com/cougz/speedwatch" target="_blank" rel="noopener" class="footer-github" aria-label="GitHub repository">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      </p>
    </footer>
  </main>

  <script>
    declare var Chart: any;

    interface TimelinePoint { hour: string; downloadMbps: number; uploadMbps: number; latencyMs: number; jitterMs: number; count: number; }
    interface SpeedtestRecord { timestamp: string; sessionID: string; endpoint: string; endpointName: string; success: boolean; download: number; upload: number; latency: number; jitter: number; downLoadedLatency: number; downLoadedJitter: number; upLoadedLatency: number; upLoadedJitter: number; }
    interface Incident { start: string; end: string; level: string; affectedMetrics: string[]; recordCount: number; worstDownloadMbps: number; worstUploadMbps: number; worstLatencyMs: number; worstJitterMs: number; }
    interface EndpointSummary { name: string; count: number; avg: { downloadMbps: number; uploadMbps: number; latencyMs: number; jitterMs: number } }

    let selectedLimit = 100;
    let selectedEndpoint = 'all';
    let serverCursor: string | null = null;
    let displayedCount = 10;
    let selectedHours = 24;
    let allRecords: SpeedtestRecord[] = [];

    let anomalyConfig: {
      warnThreshold: number;
      critThreshold: number;
    } = {
      warnThreshold: 0.70,
      critThreshold: 0.50,
    };

    async function loadAnomalyConfig() {
      try {
        const res = await fetch('/api/config');
        const config = await res.json();
        anomalyConfig = {
          warnThreshold: parseFloat(config.ANOMALY_WARN_THRESHOLD) || 0.70,
          critThreshold: parseFloat(config.ANOMALY_CRIT_THRESHOLD) || 0.50,
        };
        console.log('Loaded anomaly config from /api/config:', anomalyConfig);
      } catch (err) {
        console.error('Failed to load anomaly config:', err);
      }
    }

    function getEnv(key: string): string | undefined {
      if (typeof window !== 'undefined' && (window as any).__ENV__) {
        return (window as any).__ENV__[key];
      }
      return undefined;
    }

    let throughputChart = null;
    let latencyChart = null;

    function timelineToPath(points: TimelinePoint[], metric: keyof TimelinePoint, w: number, h: number): string {
      const values = points.map(p => Number(p[metric]));
      const max = Math.max(...values, 1);
      return points.map((p, i) => {
        const x = (i / (points.length - 1)) * w;
        const y = h - (Number(p[metric]) / max) * h;
        return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
      }).join(' ');
    }

    function median(values: number[]): number {
      if (values.length === 0) return 0;
      const sorted = [...values].sort((a, b) => a - b);
      return sorted[Math.floor(sorted.length / 2)];
    }

    function isAnomaly(
      value: number,
      allValues: number[],
      lowerIsBad: boolean = false
    ): 'ok' | 'warn' | 'crit' {
      const baseline = median(allValues);
      if (baseline === 0) return 'ok';
      if (lowerIsBad) {
        const ratio = value / baseline;
        if (ratio < anomalyConfig.critThreshold) return 'crit';
        if (ratio < anomalyConfig.warnThreshold) return 'warn';
      } else {
        const ratio = baseline / value;
        if (ratio < anomalyConfig.critThreshold) return 'crit';
        if (ratio < anomalyConfig.warnThreshold) return 'warn';
      }
      return 'ok';
    }

    async function fetchData() {
      const meta = document.getElementById('page-meta');
      if (meta) meta.textContent = 'Loading...';
      try {
        const [summaryRes, resultsRes] = await Promise.all([
          fetch(`/api/summary?hours=${selectedHours}&no-cache=true`),
          fetch(`/api/results?limit=200`)
        ]);

        if (!summaryRes.ok) throw new Error(`Summary: ${summaryRes.status}`);
        if (!resultsRes.ok) throw new Error(`Results: ${resultsRes.status}`);

        const summary = await summaryRes.json();
        const results = await resultsRes.json();

        allRecords = results.records || [];
        serverCursor = results.cursor || null;
        displayedCount = 10;

        renderKpiCards(summary);
        renderCharts(summary);
        renderIncidents(summary.incidents || []);
        renderEndpoints(summary.byEndpoint || {});
        renderTable();
        updatePageMeta(summary);
      } catch (err) {
        console.error('fetchData error:', err);
        if (meta) meta.textContent = `Error: ${err instanceof Error ? err.message : 'Unknown error'}`;
      }
    }

    function renderKpiCards(summary: any) {
      const updateKpi = (id: string, value: number, delta: number, p95Value: number) => {
        const el = document.getElementById(id);
        const deltaEl = document.getElementById(`${id}-delta`);
        el.classList.remove('loading');
        el.textContent = value.toFixed(1);
        deltaEl.textContent = `p95: ${p95Value.toFixed(1)}`;
      };

      updateKpi('kpi-download', summary.avg.downloadMbps, 0, summary.p95.downloadMbps);
      updateKpi('kpi-upload', summary.avg.uploadMbps, 0, summary.p95.uploadMbps);
      updateKpi('kpi-latency', summary.avg.latencyMs, 0, summary.p95.latencyMs);
      updateKpi('kpi-jitter', summary.avg.jitterMs, 0, summary.p95.jitterMs);

      const sparkPath = timelineToPath(summary.timeline, 'downloadMbps', 200, 36);
      document.getElementById('sparkline-download').setAttribute('d', sparkPath + ' L200,36 L0,36 Z');

      const sparkUploadPath = timelineToPath(summary.timeline, 'uploadMbps', 200, 36);
      document.getElementById('sparkline-upload').setAttribute('d', sparkUploadPath + ' L200,36 L0,36 Z');

      const sparkLatPath = timelineToPath(summary.timeline, 'latencyMs', 200, 36);
      document.getElementById('sparkline-latency').setAttribute('d', sparkLatPath + ' L200,36 L0,36 Z');

      const sparkJitPath = timelineToPath(summary.timeline, 'jitterMs', 200, 36);
      document.getElementById('sparkline-jitter').setAttribute('d', sparkJitPath + ' L200,36 L0,36 Z');
    }

    function renderCharts(summary) {
      const tl = summary.timeline || [];
      if (tl.length === 0) return;
      if (typeof Chart === 'undefined') return;

      const throughputCanvas = document.getElementById('throughput-chart') as HTMLCanvasElement;
      const latencyCanvas = document.getElementById('latency-chart') as HTMLCanvasElement;

      if (!throughputCanvas || !latencyCanvas) return;

      const labels = tl.map(p => {
        const d = new Date(p.hour);
        return d.toLocaleDateString([], {month:'short', day:'numeric'}) + ' ' +
               d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
      });

      const chartDefaults = {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#222',
            titleColor: '#d0d0d0',
            bodyColor: '#888',
            borderColor: '#2e2e2e',
            borderWidth: 1,
          }
        },
        scales: {
          x: {
            ticks: { color: '#888', font: { family: 'monospace', size: 10 }, maxTicksLimit: 8 },
            grid: { color: '#2e2e2e' }
          },
          y: {
            ticks: { color: '#888', font: { family: 'monospace', size: 10 } },
            grid: { color: '#2e2e2e' },
            beginAtZero: true
          }
        }
      };

      if (throughputChart) { throughputChart.destroy(); throughputChart = null; }
      if (latencyChart) { latencyChart.destroy(); latencyChart = null; }

      throughputChart = new Chart(throughputCanvas.getContext('2d'), {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'Download Mbps',
              data: tl.map(p => p.downloadMbps),
              borderColor: '#F48024',
              backgroundColor: 'rgba(244,128,36,0.1)',
              fill: true,
              tension: 0.3,
              pointRadius: 0,
              borderWidth: 2,
            },
            {
              label: 'Upload Mbps',
              data: tl.map(p => p.uploadMbps),
              borderColor: '#58a6ff',
              backgroundColor: 'rgba(88,166,255,0.1)',
              fill: true,
              tension: 0.3,
              pointRadius: 0,
              borderWidth: 2,
            }
          ]
        },
        options: {
          ...chartDefaults,
          plugins: {
            ...chartDefaults.plugins,
            legend: {
              display: true,
              labels: { color: '#888', font: { family: 'monospace', size: 11 }, boxWidth: 12 }
            }
          }
        }
      });

      latencyChart = new Chart(latencyCanvas.getContext('2d'), {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'Latency ms',
            data: tl.map(p => p.latencyMs),
            borderColor: '#3fb950',
            backgroundColor: 'rgba(63,185,80,0.1)',
            fill: true,
            tension: 0.3,
            pointRadius: 0,
            borderWidth: 2,
          }]
        },
        options: chartDefaults
      });
    }

    let incidentsExpanded = false;

    function renderIncidents(incidents: Incident[]) {
      const list = document.getElementById('incident-list');
      const badge = document.getElementById('incident-badge');
      const chevron = document.getElementById('incidents-chevron');
      const toggleLabel = document.getElementById('incidents-toggle-label');
      if (!list) return;

      if (badge) {
        badge.textContent = String(incidents?.length || 0);
        badge.style.background = incidents?.length ? 'rgba(248,81,73,0.15)' : 'rgba(63,185,80,0.15)';
        badge.style.color = incidents?.length ? '#f85149' : '#3fb950';
      }

      list.innerHTML = '';

      if (!incidents || !incidents.length) {
        list.innerHTML = '<div class="no-incidents">✓ No performance incidents detected</div>';
      } else {
        for (const inc of incidents) {
          const start = new Date(inc.start);
          const end = new Date(inc.end);
          const durationMs = end.getTime() - start.getTime();
          const durationStr = durationMs < 60_000
            ? `${Math.round(durationMs / 1000)}s`
            : `${Math.round(durationMs / 60_000)}m`;
          const isMulti = inc.start !== inc.end;
          const timeStr = isMulti
            ? `${start.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})} – ${end.toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'})}, ${start.toLocaleDateString([], {month:'short', day:'numeric', year:'numeric'})}`
            : start.toLocaleString([], {month:'short', day:'numeric', year:'numeric', hour:'2-digit', minute:'2-digit'});

          const metrics = [
            { label: 'Download', value: `${inc.worstDownloadMbps.toFixed(1)} Mbps`, affected: inc.affectedMetrics.includes('download') },
            { label: 'Upload',   value: `${inc.worstUploadMbps.toFixed(1)} Mbps`,   affected: inc.affectedMetrics.includes('upload') },
            { label: 'Latency', value: `${inc.worstLatencyMs.toFixed(1)} ms`,      affected: inc.affectedMetrics.includes('latency') },
            { label: 'Jitter',   value: `${inc.worstJitterMs.toFixed(2)} ms`,       affected: inc.affectedMetrics.includes('jitter') },
          ];

          const levelLabel = inc.level === 'crit' ? 'Critical degradation' : 'Performance warning';
          const levelColor = inc.level === 'crit' ? '#f85149' : '#d29922';
          const affectedStr = inc.affectedMetrics
            .map(m => m.charAt(0).toUpperCase() + m.slice(1))
            .join(', ');

          const card = document.createElement('div');
          card.className = `incident-card level-${inc.level}`;
          card.style.cssText = `
            background: var(--bg-tertiary);
            border: 1px solid var(--border-color);
            border-left: 3px solid ${inc.level === 'crit' ? '#f85149' : '#d29922'};
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 10px;
          `;
          card.innerHTML = `
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px">
              <div>
                <span style="font-size:13px; font-weight:600; color:${levelColor}">${levelLabel}</span>
                <span style="font-size:12px; color:var(--text-muted); margin-left:8px">— ${affectedStr}</span>
              </div>
              <span style="font-size:11px; color:var(--text-muted); font-family:var(--mono); white-space:nowrap; margin-left:16px">
                ${inc.recordCount} test${inc.recordCount !== 1 ? 's' : ''}${isMulti ? ` · ${durationStr}` : ''}
              </span>
            </div>
            <div style="font-size:11px; color:var(--text-muted); font-family:var(--mono); margin-bottom:12px">${timeStr}</div>
            <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:8px">
              ${metrics.map(m => `
                <div style="
                  background: var(--bg-secondary);
                  border: 1px solid ${m.affected ? (inc.level === 'crit' ? 'rgba(248,81,73,0.3)' : 'rgba(210,153,34,0.3)') : 'var(--border-color)'};
                  border-radius: 8px;
                  padding: 8px 10px;
                ">
                  <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin-bottom:4px">${m.label}</div>
                  <div style="font-size:13px; font-weight:600; font-family:var(--mono); color:${m.affected ? (inc.level === 'crit' ? '#f85149' : '#d29922') : 'var(--md)'}">${m.value}</div>
                </div>
              `).join('')}
            </div>
          `;
          list.appendChild(card);
        }
      }

      if (chevron) chevron.style.transform = incidentsExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
      if (toggleLabel) toggleLabel.textContent = incidentsExpanded ? 'Hide' : 'Show';
      list.style.display = incidentsExpanded ? 'block' : 'none';
    }

    function renderEndpoints(byEndpoint: Record<string, EndpointSummary>) {
      const wrapper = document.getElementById('endpoint-cards');
      if (!wrapper) return;
      wrapper.innerHTML = '';

      const entries = Object.values(byEndpoint || {}) as EndpointSummary[];
      if (entries.length === 0) {
        wrapper.innerHTML = '<div style="text-align:center;color:var(--text-muted);padding:24px;font-size:13px">No endpoint data</div>';
        return;
      }

      entries.sort((a, b) => b.avg.downloadMbps - a.avg.downloadMbps);
      const maxDl = Math.max(...entries.map(e => e.avg.downloadMbps), 1);

      const dlValues = entries.map(e => e.avg.downloadMbps);
      const ulValues = entries.map(e => e.avg.uploadMbps);
      const latValues = entries.map(e => e.avg.latencyMs);
      const jitValues = entries.map(e => e.avg.jitterMs);

      for (const ep of entries) {
        const barPct = Math.round((ep.avg.downloadMbps / maxDl) * 100);
        const dlLevel = isAnomaly(ep.avg.downloadMbps, dlValues, true);
        const ulLevel = isAnomaly(ep.avg.uploadMbps, ulValues, true);
        const latLevel = isAnomaly(ep.avg.latencyMs, latValues);
        const jitLevel = isAnomaly(ep.avg.jitterMs, jitValues);

        const dlColor = dlLevel === 'crit' ? '#f85149' : dlLevel === 'warn' ? '#d29922' : 'var(--brand)';
        const dlBg = dlLevel === 'crit' ? 'rgba(248,81,73,0.1)' : dlLevel === 'warn' ? 'rgba(210,153,34,0.1)' : 'transparent';
        const dlBorder = dlLevel === 'crit' ? '#f85149' : dlLevel === 'warn' ? '#d29922' : 'var(--border-color)';
        const ulColor = ulLevel === 'crit' ? '#f85149' : ulLevel === 'warn' ? '#d29922' : '#58a6ff';
        const ulBg = ulLevel === 'crit' ? 'rgba(248,81,73,0.1)' : ulLevel === 'warn' ? 'rgba(210,153,34,0.1)' : 'transparent';
        const ulBorder = ulLevel === 'crit' ? '#f85149' : ulLevel === 'warn' ? '#d29922' : 'var(--border-color)';
        const latColor = latLevel === 'crit' ? '#f85149' : latLevel === 'warn' ? '#d29922' : '#3fb950';
        const latBg = latLevel === 'crit' ? 'rgba(248,81,73,0.1)' : latLevel === 'warn' ? 'rgba(210,153,34,0.1)' : 'transparent';
        const latBorder = latLevel === 'crit' ? '#f85149' : latLevel === 'warn' ? '#d29922' : 'var(--border-color)';
        const jitColor = jitLevel === 'crit' ? '#f85149' : jitLevel === 'warn' ? '#d29922' : '#bc8cff';
        const jitBg = jitLevel === 'crit' ? 'rgba(248,81,73,0.1)' : jitLevel === 'warn' ? 'rgba(210,153,34,0.1)' : 'transparent';
        const jitBorder = jitLevel === 'crit' ? '#f85149' : jitLevel === 'warn' ? '#d29922' : 'var(--border-color)';

        const card = document.createElement('div');
        card.style.cssText = `
          background: var(--bg-tertiary);
          border: 1px solid var(--border-color);
          border-radius: 10px;
          padding: 14px 16px;
          margin-bottom: 10px;
        `;
        card.innerHTML = `
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px">
            <div style="font-size:13px; font-weight:600; color:var(--hi); font-family:var(--mono)">${ep.name}</div>
            <div style="font-size:11px; color:var(--text-muted); font-family:var(--mono)">${ep.count} test${ep.count !== 1 ? 's' : ''}</div>
          </div>
          <div style="height:3px; background:var(--border-color); border-radius:2px; margin-bottom:12px; overflow:hidden">
            <div style="height:100%; width:${barPct}%; background:var(--brand); border-radius:2px; transition:width 0.4s ease"></div>
          </div>
          <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:8px">
            <div style="background:${dlBg}; border:1px solid ${dlBorder}; border-radius:8px; padding:8px 10px">
              <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin-bottom:4px">Download</div>
              <div style="font-size:13px; font-weight:600; font-family:var(--mono); color:${dlColor}">${ep.avg.downloadMbps.toFixed(1)} <span style="font-size:10px;font-weight:400;color:var(--text-muted)">Mbps</span></div>
            </div>
            <div style="background:${ulBg}; border:1px solid ${ulBorder}; border-radius:8px; padding:8px 10px">
              <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin-bottom:4px">Upload</div>
              <div style="font-size:13px; font-weight:600; font-family:var(--mono); color:${ulColor}">${ep.avg.uploadMbps.toFixed(1)} <span style="font-size:10px;font-weight:400;color:var(--text-muted)">Mbps</span></div>
            </div>
            <div style="background:${latBg}; border:1px solid ${latBorder}; border-radius:8px; padding:8px 10px">
              <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin-bottom:4px">Latency</div>
              <div style="font-size:13px; font-weight:600; font-family:var(--mono); color:${latColor}">${ep.avg.latencyMs.toFixed(1)} <span style="font-size:10px;font-weight:400;color:var(--text-muted)">ms</span></div>
            </div>
            <div style="background:${jitBg}; border:1px solid ${jitBorder}; border-radius:8px; padding:8px 10px">
              <div style="font-size:9px; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin-bottom:4px">Jitter</div>
              <div style="font-size:13px; font-weight:600; font-family:var(--mono); color:${jitColor}">${ep.avg.jitterMs.toFixed(2)} <span style="font-size:10px;font-weight:400;color:var(--text-muted)">ms</span></div>
            </div>
          </div>
        `;
        wrapper.appendChild(card);
      }
    }

    function renderTable() {
      const tbody = document.getElementById('results-body');
      tbody.innerHTML = '';

      const filtered = selectedEndpoint === 'all'
        ? allRecords
        : allRecords.filter(r => r.endpointName === selectedEndpoint);

      const WINDOW_SIZE = 100;
      const recentRecords = filtered.slice(0, WINDOW_SIZE);

      const dlValues = recentRecords.map(r => r.download);
      const ulValues = recentRecords.map(r => r.upload);
      const latValues = recentRecords.map(r => r.latency);
      const jitValues = recentRecords.map(r => r.jitter);

      const slice = filtered.slice(0, displayedCount);
      for (const rec of slice) {
        const dlLevel = isAnomaly(rec.download, dlValues, true);
        const ulLevel = isAnomaly(rec.upload, ulValues, true);
        const latLevel = isAnomaly(rec.latency, latValues);
        const jitLevel = isAnomaly(rec.jitter, jitValues);

        const dlColor = dlLevel === 'crit' ? '#f85149' : dlLevel === 'warn' ? '#d29922' : 'var(--brand)';
        const dlBg = dlLevel === 'crit' ? 'rgba(248,81,73,0.15)' : dlLevel === 'warn' ? 'rgba(210,153,34,0.15)' : 'transparent';
        const ulColor = ulLevel === 'crit' ? '#f85149' : ulLevel === 'warn' ? '#d29922' : '#58a6ff';
        const ulBg = ulLevel === 'crit' ? 'rgba(248,81,73,0.15)' : ulLevel === 'warn' ? 'rgba(210,153,34,0.15)' : 'transparent';
        const latColor = latLevel === 'crit' ? '#f85149' : latLevel === 'warn' ? '#d29922' : '#3fb950';
        const latBg = latLevel === 'crit' ? 'rgba(248,81,73,0.15)' : latLevel === 'warn' ? 'rgba(210,153,34,0.15)' : 'transparent';
        const jitColor = jitLevel === 'crit' ? '#f85149' : jitLevel === 'warn' ? '#d29922' : '#bc8cff';
        const jitBg = jitLevel === 'crit' ? 'rgba(248,81,73,0.15)' : jitLevel === 'warn' ? 'rgba(210,153,34,0.15)' : 'transparent';

        const row = document.createElement('tr');
        row.style.cssText = `border-bottom: 1px solid var(--border-color); transition: background 0.15s; ${!rec.success ? 'border-left: 3px solid #f85149;' : ''}`;
        row.onmouseenter = () => row.style.background = 'var(--bg-tertiary)';
        row.onmouseleave = () => row.style.background = '';
        row.innerHTML = `
          <td style="padding:10px 12px; color:var(--text-muted); font-family:var(--mono); font-size:11px; white-space:nowrap">
            ${new Date(rec.timestamp).toLocaleString([], {month:'short',day:'numeric',hour:'2-digit',minute:'2-digit',second:'2-digit'})}
          </td>
          <td style="padding:10px 12px; font-family:var(--mono); font-size:11px; color:var(--hi)">${rec.endpointName}</td>
          <td style="padding:10px 12px; font-family:var(--mono); font-size:11px; color:var(--text-muted)">${rec.sessionID.substring(0,8)}…</td>
          <td style="padding:10px 12px; background:${dlBg}; border-radius:4px;">
            <span style="font-family:var(--mono); font-size:12px; font-weight:600; color:${dlColor}">${rec.download.toFixed(1)}</span>
            <span style="font-family:var(--mono); font-size:10px; color:var(--text-muted)"> Mbps</span>
          </td>
          <td style="padding:10px 12px; background:${ulBg}; border-radius:4px;">
            <span style="font-family:var(--mono); font-size:12px; font-weight:600; color:${ulColor}">${rec.upload.toFixed(1)}</span>
            <span style="font-family:var(--mono); font-size:10px; color:var(--text-muted)"> Mbps</span>
          </td>
          <td style="padding:10px 12px; background:${latBg}; border-radius:4px;">
            <span style="font-family:var(--mono); font-size:12px; font-weight:600; color:${latColor}">${rec.latency.toFixed(1)}</span>
            <span style="font-family:var(--mono); font-size:10px; color:var(--text-muted)"> ms</span>
          </td>
          <td style="padding:10px 12px; font-family:var(--mono); font-size:11px; color:var(--text-muted)">${rec.downLoadedLatency.toFixed(1)} ms</td>
          <td style="padding:10px 12px; font-family:var(--mono); font-size:11px; color:var(--text-muted)">${rec.upLoadedLatency.toFixed(1)} ms</td>
          <td style="padding:10px 12px; background:${jitBg}; border-radius:4px;">
            <span style="font-family:var(--mono); font-size:12px; font-weight:600; color:${jitColor}">${rec.jitter.toFixed(2)}</span>
            <span style="font-family:var(--mono); font-size:10px; color:var(--text-muted)"> ms</span>
          </td>
        `;
        tbody.appendChild(row);
      }
      updateLoadMoreBtn(filtered);
    }

    function updateLoadMoreBtn(filtered) {
      const btn = document.getElementById('load-more') as HTMLButtonElement;
      const hasMoreLocal  = filtered.length > displayedCount;
      const hasMoreServer = !!serverCursor;
      btn.disabled = !hasMoreLocal && !hasMoreServer;
      if (hasMoreLocal) {
        btn.textContent = `Show More (${filtered.length - displayedCount} in memory)`;
      } else if (hasMoreServer) {
        btn.textContent = 'Load More from Server';
      } else {
        btn.textContent = 'No More Results';
      }
    }

    function updatePageMeta(summary) {
      const meta = document.getElementById('page-meta');
      const pct = summary.successRate >= 1 ? '100%' : `${(summary.successRate * 100).toFixed(0)}%`;
      meta.textContent = `${summary.totalRecords} records · ${pct} success · last ${selectedHours}h`;
    }

    document.querySelectorAll('.count-pill').forEach(pill => {
      const pillEl = pill as HTMLElement;
      pillEl.addEventListener('click', () => {
        document.querySelectorAll('.count-pill').forEach(p => p.classList.remove('active'));
        pillEl.classList.add('active');
        selectedLimit = parseInt(pillEl.dataset.limit || '100');
        fetchData();
      });
    });

    document.querySelectorAll('.time-pill').forEach(pill => {
      const pillEl = pill as HTMLElement;
      pillEl.addEventListener('click', () => {
        document.querySelectorAll('.time-pill').forEach(p => p.classList.remove('active'));
        document.getElementById('custom-pill')?.classList.remove('active');
        pillEl.classList.add('active');
        selectedHours = parseInt(pillEl.dataset.hours || '24', 10);
        const fromInput = document.getElementById('custom-from') as HTMLInputElement;
        const toInput = document.getElementById('custom-to') as HTMLInputElement;
        fromInput.style.opacity = '0.35';
        fromInput.style.color = 'var(--text-muted)';
        fromInput.style.pointerEvents = 'none';
        fromInput.value = '';
        toInput.style.opacity = '0.35';
        toInput.style.color = 'var(--text-muted)';
        toInput.style.pointerEvents = 'none';
        toInput.value = '';
        fetchData();
      });
    });

    document.getElementById('custom-pill')?.addEventListener('click', () => {
      document.querySelectorAll('.time-pill').forEach(p => p.classList.remove('active'));
      document.getElementById('custom-pill')?.classList.add('active');
      const fromInput = document.getElementById('custom-from') as HTMLInputElement;
      const toInput = document.getElementById('custom-to') as HTMLInputElement;
      fromInput.style.opacity = '1';
      fromInput.style.color = 'var(--hi)';
      fromInput.style.pointerEvents = 'auto';
      toInput.style.opacity = '1';
      toInput.style.color = 'var(--hi)';
      toInput.style.pointerEvents = 'auto';
      fromInput.focus();
    });

    function applyCustomDateRange() {
      const fromInput = document.getElementById('custom-from') as HTMLInputElement;
      const toInput = document.getElementById('custom-to') as HTMLInputElement;
      if (fromInput.value && toInput.value) {
        const fromDate = new Date(fromInput.value);
        const toDate = new Date(toInput.value);
        const diffMs = toDate.getTime() - fromDate.getTime();
        const hours = diffMs / (1000 * 60 * 60);
        if (hours > 0) {
          selectedHours = hours;
          fetchData();
        }
      }
    }

    document.getElementById('custom-from')?.addEventListener('change', applyCustomDateRange);
    document.getElementById('custom-to')?.addEventListener('change', applyCustomDateRange);

    document.getElementById('incidents-header')?.addEventListener('click', () => {
      incidentsExpanded = !incidentsExpanded;
      const list = document.getElementById('incident-list');
      const chevron = document.getElementById('incidents-chevron');
      const toggleLabel = document.getElementById('incidents-toggle-label');
      if (list) list.style.display = incidentsExpanded ? 'block' : 'none';
      if (chevron) chevron.style.transform = incidentsExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
      if (toggleLabel) toggleLabel.textContent = incidentsExpanded ? 'Hide' : 'Show';
    });

    document.getElementById('load-more')?.addEventListener('click', async () => {
      const filtered = selectedEndpoint === 'all'
        ? allRecords
        : allRecords.filter(r => r.endpointName === selectedEndpoint);

      if (filtered.length > displayedCount) {
        displayedCount += 10;
        renderTable();
        return;
      }

      if (!serverCursor) return;
      const btn = document.getElementById('load-more') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Loading…';
      try {
        const res  = await fetch(`/api/results?limit=100&cursor=${serverCursor}`);
        const data = await res.json();
        allRecords   = allRecords.concat(data.records || []);
        serverCursor = data.cursor || null;
        renderTable();
      } catch (err) {
        console.error('Failed to load more:', err);
        btn.disabled = false;
        btn.textContent = 'Retry Load More';
      }
    });

    function init() {
      if (typeof Chart === 'undefined') {
        setTimeout(init, 100);
        return;
      }
      loadAnomalyConfig().then(() => {
        setInterval(fetchData, 60000);
        fetchData();
      });
    }

    init();
  </script>
</Layout>
