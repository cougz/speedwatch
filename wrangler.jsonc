{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "speedwatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api*", "/llms.txt"]
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "grainau-speedtest-results",
      "jurisdiction": "eu"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": {
    "R2_PREFIX": "speedtest-results/",
    "CACHE_TTL_SECONDS": "60",
    "MAX_RESULTS_PER_PAGE": "200"
  }
}
